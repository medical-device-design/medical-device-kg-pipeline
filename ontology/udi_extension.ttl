# ontology/udi_extension.ttl
#
# Vocabulary additions for the AccessGUDID (UDI) ingest.
# Merge into ontology.ttl at the next rebuild, or upload alongside it.
#
# Namespace is the post-migration one. Before the September 2026 migration,
# substitute http://medicaldevice.com/ontology/ .

@prefix ex:   <https://bmedesign.org/medical-device-kg/ns/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =========================
# CLASSES
# =========================

ex:UDIDeviceRecord a rdfs:Class ;
    rdfs:subClassOf ex:FDADataRecord ;
    rdfs:label "UDI Device Record (AccessGUDID)" ;
    rdfs:comment "One published GUDID device record, identified by its stable public_device_record_key UUID. Carries the physical and labelling attributes of a marketed device." .

ex:UDIIdentifier a rdfs:Class ;
    rdfs:label "UDI Device or Package Identifier" ;
    rdfs:comment "One entry from the GUDID identifiers array: a Primary DI, Package DI, or Unit-of-Use DI, issued by GS1, HIBCC or ICCBBA." .

ex:GMDNTerm a rdfs:Class ;
    rdfs:label "GMDN Term" ;
    rdfs:comment "Global Medical Device Nomenclature term. The only external controlled vocabulary present anywhere in FDA device data, and therefore the graph's most promising bridge to non-FDA sources." .

ex:Labeler a rdfs:Class ;
    rdfs:label "UDI Labeler" ;
    rdfs:comment "The organisation that labels a device, identified by D-U-N-S number. Deliberately kept DISTINCT from ex:Manufacturer, which is keyed on FEI or on a slugified name. FDA publishes no FEI-to-DUNS crosswalk, so equating them would be a guess." .

ex:StorageCondition a rdfs:Class ;
    rdfs:label "Storage and Handling Condition" ;
    rdfs:comment "A typed storage requirement with high/low values and units, e.g. a temperature range." .

# =========================
# OBJECT PROPERTIES
# =========================

ex:hasIdentifier a rdf:Property ;
    rdfs:domain ex:UDIDeviceRecord ; rdfs:range ex:UDIIdentifier ;
    rdfs:label "has UDI identifier" .

ex:belongsToDevice a rdf:Property ;
    rdfs:domain ex:UDIIdentifier ; rdfs:range ex:UDIDeviceRecord ;
    rdfs:label "belongs to device record" .

ex:hasGMDNTerm a rdf:Property ;
    rdfs:range ex:GMDNTerm ;
    rdfs:label "has GMDN term" .

ex:hasLabeler a rdf:Property ;
    rdfs:domain ex:UDIDeviceRecord ; rdfs:range ex:Labeler ;
    rdfs:label "has labeler" .

ex:hasStorageCondition a rdf:Property ;
    rdfs:domain ex:UDIDeviceRecord ; rdfs:range ex:StorageCondition ;
    rdfs:label "has storage condition" .

ex:appliesToDevice a rdf:Property ;
    rdfs:domain ex:StorageCondition ; rdfs:range ex:UDIDeviceRecord ;
    rdfs:label "applies to device record" .

# The two joins that connect a physical marketed device to the regulatory
# record that authorised it. These are the highest-value edges the UDI
# ingest adds to the graph.

ex:relatedK510Record a rdf:Property ;
    rdfs:domain ex:UDIDeviceRecord ; rdfs:range ex:K510Record ;
    rdfs:label "cleared under 510(k) or De Novo record" .

ex:relatedPMARecord a rdf:Property ;
    rdfs:domain ex:UDIDeviceRecord ; rdfs:range ex:PMARecord ;
    rdfs:label "approved under PMA record" .

# =========================
# DESIGN ATTRIBUTES
# These are the reason this source is worth ingesting: no other FDA
# database describes how marketed devices are physically constructed.
# =========================

ex:isSterile a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is supplied sterile" .
ex:requiresSterilizationPriorToUse a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "requires sterilization prior to use" .
ex:sterilizationMethod a rdf:Property ;
    rdfs:label "sterilization method" ;
    rdfs:comment "e.g. Ethylene Oxide, Radiation, Moist Heat or Steam. Repeatable." .

ex:isSingleUse a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is single use" .
ex:isKit a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is a kit" .
ex:isCombinationProduct a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is a combination product" .
ex:isHCTP a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is a human cell, tissue or cellular/tissue-based product" .
ex:isLabeledAsNRL a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "labeled as containing natural rubber latex" .
ex:isLabeledAsNoNRL a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "labeled as not made with natural rubber latex" .
ex:mriSafetyStatus a rdf:Property ;
    rdfs:label "MRI safety status" ;
    rdfs:comment "MR Safe, MR Conditional, MR Unsafe, or a statement that labeling contains no MRI safety information." .

ex:isRx a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is prescription use" .
ex:isOTC a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is over-the-counter" .
ex:isPremarketExempt a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is premarket exempt" .
ex:isDirectMarkingExempt a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "is direct marking exempt" .

ex:hasLotOrBatchNumber a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "carries a lot or batch number" .
ex:hasSerialNumber a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "carries a serial number" .
ex:hasExpirationDate a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "carries an expiration date" .
ex:hasManufacturingDate a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "carries a manufacturing date" .
ex:hasDonationIdNumber a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "carries a donation identification number" .

ex:deviceCountInBasePackage a rdf:Property ; rdfs:range xsd:integer ;
    rdfs:label "device count in base package" .

# =========================
# IDENTIFIER AND LABELER FIELDS
# =========================

ex:publicDeviceRecordKey a rdf:Property ; rdfs:label "public device record key (UUID)" .
ex:identifierId a rdf:Property ; rdfs:label "UDI identifier value" .
ex:identifierType a rdf:Property ; rdfs:label "identifier type (Primary / Package / Unit of Use)" .
ex:issuingAgency a rdf:Property ; rdfs:label "issuing agency (GS1 / HIBCC / ICCBBA)" .
ex:packageType a rdf:Property ; rdfs:label "package type" .
ex:quantityPerUnitOfUse a rdf:Property ; rdfs:range xsd:integer ;
    rdfs:label "quantity per package" .
ex:unitOfUseId a rdf:Property ; rdfs:label "unit-of-use identifier" .
ex:dunsNumber a rdf:Property ; rdfs:label "D-U-N-S number" .

ex:gmdnTermCode a rdf:Property ; rdfs:label "GMDN term code" .
ex:gmdnTermName a rdf:Property ; rdfs:label "GMDN term name" .
ex:gmdnTermDefinition a rdf:Property ; rdfs:label "GMDN term definition" .
ex:gmdnImplantable a rdf:Property ; rdfs:range xsd:boolean ;
    rdfs:label "GMDN term denotes an implantable device" .
ex:gmdnCodeStatus a rdf:Property ; rdfs:label "GMDN code status (Active / Obsolete)" .

ex:recordStatus a rdf:Property ; rdfs:label "GUDID record status" .
ex:publicVersionDate a rdf:Property ; rdfs:range xsd:date ;
    rdfs:label "public version date" .

ex:storageType a rdf:Property ; rdfs:label "storage condition type" .
ex:storageHighValue a rdf:Property ; rdfs:label "storage range high value" .
ex:storageHighUnit a rdf:Property ; rdfs:label "storage range high unit" .
ex:storageLowValue a rdf:Property ; rdfs:label "storage range low value" .
ex:storageLowUnit a rdf:Property ; rdfs:label "storage range low unit" .
ex:specialConditions a rdf:Property ; rdfs:label "special storage conditions" .
